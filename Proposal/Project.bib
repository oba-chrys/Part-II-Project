@online{bongiovanniMPXGATAttentionBased2024,
  title = {{{MPXGAT}}: {{An Attention}} Based {{Deep Learning Model}} for {{Multiplex Graphs Embedding}}},
  shorttitle = {{{MPXGAT}}},
  author = {Bongiovanni, Marco and Gallo, Luca and Grasso, Roberto and Pulvirenti, Alfredo},
